YANDEX_S3_ENDPOINT_URL=https://storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
YANDEX_S3_BUCKET=ts-project-bucket

# Реальные AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY не коммитить.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=ru-central1

# MLFLOW_TRACKING_URI указывает на MLflow Tracking Server.
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=ts-project
MLFLOW_REGISTERED_MODEL_NAME=ts-project-forecast-model
MLFLOW_MODEL_ALIAS=champion

# MLflow artifact storage через Yandex Object Storage.
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net

# MLFLOW_DEFAULT_ARTIFACT_ROOT должен быть S3 path в Yandex Object Storage.
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://ts-project-bucket/mlflow-artifacts

# Backend store для локальной разработки.
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db

# Production model loading.
MODEL_REGISTRY_URI=models:/ts-project-forecast-model@champion

# Backward-compatible aliases used by existing scripts.
MLFLOW_ARTIFACT_ROOT=s3://ts-project-bucket/mlflow-artifacts
MLFLOW_MODEL_NAME=ts-project-forecast-model
MLFLOW_CHALLENGER_ALIAS=challenger
MLFLOW_CHAMPION_ALIAS=champion
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=mlflow
POSTGRES_HOST=mlflow-postgres
POSTGRES_PORT=5432
MODEL_URI=s3://ts-project-bucket/models/production/model.pkl
FEATURE_PIPELINE_URI=s3://ts-project-bucket/models/production/feature_pipeline.pkl
MODEL_METADATA_URI=s3://ts-project-bucket/models/production/model_metadata.json
LOG_LEVEL=INFO
