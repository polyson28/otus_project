# Yandex Cloud common settings.
YC_CLOUD_ID=replace_me
YC_FOLDER_ID=replace_me
YC_CONTAINER_REGISTRY_ID=replace_me
IMAGE_TAG=latest

# Yandex Object Storage. Do not commit real access keys.
YANDEX_S3_ENDPOINT_URL=https://storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
YANDEX_S3_BUCKET=ts-project-bucket
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=ru-central1

# Production data/artifact layout in Object Storage.
RAW_DATA_URI=s3://ts-project-bucket/raw/
INTERIM_DATA_URI=s3://ts-project-bucket/interim/data.parquet
REFERENCE_DATA_URI=s3://ts-project-bucket/interim/reference_data.parquet
FEATURES_URI=s3://ts-project-bucket/features/features.parquet
FEATURE_PIPELINE_URI=s3://ts-project-bucket/features/feature_pipeline.pkl
FEATURE_SCHEMA_URI=s3://ts-project-bucket/features/feature_schema.json
PREDICTIONS_URI=s3://ts-project-bucket/predictions
REFERENCE_PREDICTIONS_URI=s3://ts-project-bucket/predictions/reference_predictions.parquet
ACTUALS_URI=s3://ts-project-bucket/actuals/actuals.parquet
MONITORING_REPORTS_URI=s3://ts-project-bucket/monitoring

# MLflow tracking and Model Registry.
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=ts-project
MLFLOW_REGISTERED_MODEL_NAME=ts-project-forecast-model
MLFLOW_MODEL_ALIAS=champion
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://ts-project-bucket/mlflow-artifacts
MLFLOW_ARTIFACT_ROOT=s3://ts-project-bucket/mlflow-artifacts

# Backend store for local docker-compose MLflow Model Registry.
# In production use Yandex Managed PostgreSQL or another database-backed backend store.
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:replace_me@mlflow-postgres:5432/mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=mlflow
POSTGRES_HOST=mlflow-postgres
POSTGRES_PORT=5432

# FastAPI model loading and hot reload.
MODEL_SOURCE=mlflow
REGISTERED_MODEL_NAME=ts-project-forecast-model
MODEL_ALIAS=latest
MODEL_REGISTRY_URI=models:/ts-project-forecast-model@champion
MODEL_URI=models:/ts-project-forecast-model@champion
MODEL_METADATA_URI=
API_RELOAD_URL=http://api:8000/reload_model

# Backward-compatible aliases used by existing scripts.
MLFLOW_MODEL_NAME=ts-project-forecast-model
MLFLOW_CHALLENGER_ALIAS=challenger
MLFLOW_CHAMPION_ALIAS=champion

# Airflow. In Yandex Managed Airflow set these as Airflow Variables/Connections or secrets.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
TRAIN_RUN_NAME=airflow_monthly_train
TRAIN_SUMMARY_URI=s3://ts-project-bucket/training/train_summary_latest.json
EVALUATION_URI=s3://ts-project-bucket/training/evaluation_latest.json

LOG_LEVEL=INFO
